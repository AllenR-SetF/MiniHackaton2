# Copy to .env for local dev. On the host (Render, Railway, ...) set these as
# environment variables instead. NEVER commit the real .env.

NODE_ENV=production
PORT=3000
TEAM=prjM3
BASE_PATH=/prjM3

# Exact origin(s) of the deployed frontend, comma-separated, no trailing slash.
FRONTEND_ORIGIN=https://YOUR-GITHUB-USER.github.io

# Set to 1 when running behind a reverse proxy (Render/Railway/Fly all are).
TRUST_PROXY=1

# Long random string, generate with: npm run gen-jwt-secret
# Must NOT change during the hackathon (changing it invalidates issued JWTs).
JWT_SECRET=

ADMIN_USERNAME=admin
# Phase 1: BCIT12. Phase 2: change to a new password (max 6 chars).
ADMIN_PASSWORD=BCIT12
# Phase 1: defaultSecret. Phase 2: change (< 20 chars, no spaces).
SECRET=defaultSecret
